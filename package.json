{
  "name": "@skalenetwork/programmable-privacy",
  "version": "0.0.0",
  "private": true,
  "description": "SKALE Programmable Privacy — SDK & MCP Server",
  "repository": {
    "type": "git",
    "url": "https://github.com/skalenetwork/privacy-sdk.git"
  },
  "homepage": "https://github.com/skalenetwork/privacy-sdk#readme",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
